   "source": [
    "n = int(input(\"Nhap n: \"))\n",
    "t = 1\n",
    "\n",
    "if n % 2 == 1:        # n lẻ\n",
    "    for i in range(1, n+1, 2):\n",
    "        t = t * i\n",
    "else:                 # n chẵn\n",
    "    for i in range(2, n+1, 2):\n",
    "        t = t * i\n",
    "\n",
    "print(\"T7 =\", t)\n"
   ],
