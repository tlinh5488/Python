   },
   "source": [
    "tienGui=float(input(\"Nhập số tiền gửi:\"))\n",
    "tienNhan=float(input(\"Nhập số tiền nhận được:\"))\n",
    "laiSuat=float(input(\"Nhập lãi suất 1 tháng:\"))\n",
    "thang=0\n",
    "while tienGui<tienNhan:\n",
    "    tienGui = tienGui + tienGui*laiSuat/100\n",
    "    thang = thang +1\n",
    "print(\"Số tháng gửi tiết kiệm là:\"+str(thang))"
   ],
