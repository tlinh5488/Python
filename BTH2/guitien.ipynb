   "source": [
    "tienGui=float(input(\"Nhập tiền gửi:\"))\n",
    "soThang=float(input(\"Nhập số tháng gửi:\"))\n",
    "laiSuat=float(input(\"Nhập lãi suất 1 tháng:\"))\n",
    "i=1\n",
    "while i <= soThang:\n",
    "    tienGui = tienGui + tienGui*laiSuat/100\n",
    "    i = i + 1\n",
    "print(\"Số tiền nhận: \" + str(tienGui))\n"
   ],
