    "import math\n",
    "a=int(input(\"Nhập số thứ nhất:\"))\n",
    "b=int(input(\"Nhập số thứ hai:\"))\n",
    "\n",
    "x, y=a, b\n",
    "while y!= 0:\n",
    "    x, y = y, x%y\n",
    "ucln = x\n",
    "bcnn = a*b//ucln\n",
    "print(\"Bội chung nhỏ nhất:\", bcnn)"
