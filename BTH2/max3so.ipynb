   "source": [
    "a=int(input(\"Nhập số thứ nhất:\"))\n",
    "b=int(input(\"Nhập số thứ hai:\"))\n",
    "c=int(input(\"Nhập số thứ ba:\"))\n",
    "max=a\n",
    "if b>max and b>c:\n",
    "    max=b\n",
    "elif c>max:\n",
    "    max=c\n",
    "else:\n",
    "    max=a\n",
    "print(\"Số lớn nhất là số:\" + str(max))\n"
